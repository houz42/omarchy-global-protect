#!/bin/bash
# Interactive installer for the `vpnc` package (provides /etc/vpnc/vpnc-script,
# the base script our routing hook delegates to), run in a visible terminal
# since pacman needs to show output / prompt for confirmation.

set -eu

if [[ -x /etc/vpnc/vpnc-script ]]; then
  echo "vpnc is already installed."
  exit 0
fi

exec sudo pacman -S --needed vpnc
