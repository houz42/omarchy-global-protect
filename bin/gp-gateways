#!/bin/bash
# Prints the gateway list as JSON: [{"key":...,"fqdn":...,"label":...}, ...]
# Reads the cache file `gp-wrapper discover` maintains directly -- no
# separate caching here, always a fresh read.
#
# Bounded and validated at the producer: the data originates from a remote
# portal's XML, so cap rows/field lengths and require well-formed key/fqdn
# shapes before any of it reaches QML (which renders `label` as plain text
# and builds connect commands from `key`/`fqdn`).

set -u

GATEWAYS_FILE="${XDG_CACHE_HOME:-${HOME}/.cache}/houz42-global-protect/gateways.tsv"

[[ -f "$GATEWAYS_FILE" ]] || { echo "[]"; exit 0; }

head -n 256 "$GATEWAYS_FILE" | jq -R '
  split("|") as $f
  | { key:   (($f[0] // "") | .[0:64]),
      label: (($f[1] // "") | .[0:128]),
      fqdn:  (($f[2] // "") | .[0:253]) }
  | select(.key | test("^[a-z0-9]{1,64}$"))
  | select(.fqdn | test("^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$"))
' | jq -sc '.[0:64]'
